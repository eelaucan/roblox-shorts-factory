# Anthropic — used by pipeline/script_writer.py
ANTHROPIC_API_KEY=sk-ant-...
# Model that writes the episode spec
SCRIPT_MODEL=claude-sonnet-5

# Higgsfield CLI auth is NOT an env var — run `higgsfield auth login` once.

# YouTube (optional). OAuth client secret JSON path for the Data API v3.
# Create at console.cloud.google.com -> APIs & Services -> Credentials (Desktop app).
YOUTUBE_CLIENT_SECRET=client_secret.json
